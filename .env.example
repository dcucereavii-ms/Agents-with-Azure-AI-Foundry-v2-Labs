# Azure AI Foundry Project
AIPROJECT_ENDPOINT=https://<your-project-name>.eastus2.api.azureml.ms
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>
AZURE_AI_PROJECT_NAME=<your-project-name>

# Model
MODEL_DEPLOYMENT=gpt-4o

# Bing Connection (Lab 1)
BING_CONNECTION_NAME=<your-bing-connection-name>

# Azure Monitor / App Insights (Lab 3)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=...

# Teams Bot (Lab 4 - optional)
TEAMS_APP_ID=<your-teams-app-id>
TEAMS_APP_PASSWORD=<your-teams-app-password>
