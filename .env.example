# ─────────────────────────────────────────────────────────────────────────────
# Workshop .env — copy this file to .env and fill values supplied by the instructor.
# All labs read these via python-dotenv.
# ─────────────────────────────────────────────────────────────────────────────

# ── Azure AI Foundry project (all labs) ──────────────────────────────────────
AIPROJECT_ENDPOINT=https://<your-project-name>.services.ai.azure.com/api/projects/<your-project>
MODEL_DEPLOYMENT=gpt-4o

# ── Lab 3: OpenTelemetry → Application Insights ──────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/

# ── Lab 4: judge LLM for azure-ai-evaluation ───────────────────
# Auth is Entra ID (DefaultAzureCredential) -- no key needed. Run `az login`.
AZURE_OPENAI_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
